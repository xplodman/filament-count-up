{
    "name": "xplodman/filament-count-up",
    "description": "Animated count-up numbers for Filament stat widgets and table columns",
    "keywords": [
        "xplodman",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-count-up"
    ],
    "homepage": "https://github.com/xplodman/filament-count-up",
    "support": {
        "issues": "https://github.com/xplodman/filament-count-up/issues",
        "source": "https://github.com/xplodman/filament-count-up"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "xplodman",
            "email": "a.elsayed.it@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "phpstan/extension-installer": "^1.3",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Xplodman\\CountUp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Xplodman\\CountUp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Xplodman\\CountUp\\CountUpServiceProvider"
            ],
            "aliases": {
                "CountUp": "Xplodman\\CountUp\\Facades\\CountUp"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
